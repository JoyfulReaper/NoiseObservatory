@page
@model TCPNoiseObservatory.Pages.IndexModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TCPNoise Observatory</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <script src="~/js/site.js" defer></script>
</head>
<body>
    <main class="observatory-shell">
        <header class="masthead">
            <div>
                <p class="eyebrow">Live unsolicited traffic monitor</p>
                <h1>TCPNoise Observatory</h1>
                <p class="subtitle">A sanitized view of the background noise hitting public Internet sensors.</p>
            </div>
            <div class="status-panel">
                <span class="status-label">Current conditions</span>
                <strong class="status-value">@Model.NoiseLevel</strong>
            </div>
        </header>

        <nav class="site-nav" aria-label="Main navigation">
            <a href="@Url.Page("/Index")" aria-current="page">Live dashboard</a>
            <a href="@Url.Page("/About")">About</a>
        </nav>

        <div class="refresh-controls">
            <button type="button" id="refresh-now">Refresh now</button>

            <label>
                <input type="checkbox" id="auto-refresh" checked />
                Auto refresh
            </label>

            <span id="refresh-status">@(Model.RefreshIntervalMilliseconds / 1000)s</span>
        </div>

        <section class="metrics" aria-label="Current noise metrics">
            <article class="metric-card">
                <span class="metric-label">Last 5 minutes</span>
                <strong class="metric-value">@Model.Snapshot.EventsLastFiveMinutes</strong>
                <span class="metric-unit">connection attempts</span>
            </article>

            <article class="metric-card">
                <span class="metric-label">Last hour</span>
                <strong class="metric-value">@Model.Snapshot.EventsLastHour</strong>
                <span class="metric-unit">connection attempts</span>
            </article>

            <article class="metric-card">
                <span class="metric-label">Recent sample</span>
                <strong class="metric-value">@Model.Snapshot.RecentEvents.Count</strong>
                <span class="metric-unit">sanitized events</span>
            </article>
        </section>

        <section class="history-panel" aria-labelledby="history-title">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Traffic over time</p>
                    <h2 id="history-title">60-minute history</h2>
                </div>
                <span class="privacy-note">Events / calendar minute</span>
            </div>
            @if (Model.Snapshot.History is not { } history)
            {
                <p class="history-unavailable">History is not available in this snapshot yet.</p>
            }
            else
            {
                var peak = history.Counts.Max();
                var firstMinute = history.FirstMinute;
                var currentMinute = firstMinute.AddMinutes(59);
                <figure class="traffic-history" aria-describedby="history-note">
                    <figcaption class="history-caption">
                        @firstMinute.ToString("MMM dd, HH:mm") &ndash; @history.AsOf.ToString("MMM dd, HH:mm:ss") UTC
                    </figcaption>
                    <div class="history-scale" aria-hidden="true">
                        <span>Events / minute</span>
                        <span>Peak @peak.ToString("N0")</span>
                    </div>
                    <div class="history-plot">
                        <span class="history-hint" aria-hidden="true">Hover or focus a bar to inspect</span>
                        <ol class="history-bars" aria-label="Minute event counts, oldest first">
                            @for (var i = 0; i < history.Counts.Count; i++)
                            {
                                var minute = firstMinute.AddMinutes(i);
                                var count = history.Counts[i];
                                var isCurrent = i == 59;
                                var height = peak == 0 ? "0" : (100d * count / peak).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
                                var endTime = isCurrent ? history.AsOf.ToString("HH:mm:ss") : minute.AddMinutes(1).ToString("HH:mm");
                                var label = $"{minute:HH:mm}–{endTime} UTC: {count:N0} events{(isCurrent ? " (current minute, partial)" : "")}";
                                <li class="history-minute @(isCurrent ? "is-current" : "") @(count == 0 ? "is-zero" : "")"
                                    tabindex="0" aria-label="@label">
                                    <span class="history-fill" style="height: @(height)%" aria-hidden="true"></span>
                                    <span class="history-tooltip" aria-hidden="true">@label</span>
                                </li>
                            }
                        </ol>
                    </div>
                    <div class="history-axis" aria-hidden="true">
                        <span>@firstMinute.ToString("HH:mm")</span>
                        <span>@firstMinute.AddMinutes(30).ToString("HH:mm")</span>
                        <span>@currentMinute.ToString("HH:mm") <span class="history-partial">partial</span></span>
                    </div>
                    @if (peak == 0)
                    {
                        <p class="history-empty">No events recorded in these minutes.</p>
                    }
                    <p id="history-note" class="history-note">
                        The striped bar is the current, incomplete minute. Calendar-minute bars differ from the rolling last-hour statistic.
                        As of @history.AsOf.ToString("yyyy-MM-dd HH:mm:ss") UTC.
                    </p>
                    <details class="history-details">
                        <summary>Read minute counts</summary>
                        <dl class="history-counts">
                            @for (var i = 0; i < history.Counts.Count; i++)
                            {
                                <div>
                                    <dt>@firstMinute.AddMinutes(i).ToString("HH:mm") UTC@(i == 59 ? " (partial)" : "")</dt>
                                    <dd>@history.Counts[i].ToString("N0") events</dd>
                                </div>
                            }
                        </dl>
                    </details>
                </figure>
            }
        </section>

        <section class="activity-panel">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Observation log</p>
                    <h2>Recent activity</h2>
                </div>
                <span class="privacy-note">Source addresses are masked</span>
            </div>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Sensor</th>
                            <th>Protocol</th>
                            <th>Port</th>
                            <th>Seen</th>
                            <th>Source</th>
                        </tr>
                    </thead>
                    <tbody>
                    @for (var i = 0; i < Model.Snapshot.RecentEvents.Count; i++)
                    {
                        var noiseEvent = Model.Snapshot.RecentEvents[i];
                        var detailId = $"event-detail-{i}";

                        <tr class="event-row"
                            tabindex="0"
                            role="button"
                            aria-expanded="false"
                            aria-controls="@detailId"
                            data-detail-id="@detailId">
                            <td>@noiseEvent.Timestamp.ToString("HH:mm:ss")</td>
                            <td>@noiseEvent.Sensor</td>
                            <td>@noiseEvent.Protocol</td>
                            <td>@noiseEvent.DestinationPort</td>
                            <td>@noiseEvent.SeenCount</td>
                            <td>@noiseEvent.Source</td>
                        </tr>
                        <tr id="@detailId" class="event-detail-row" hidden>
                            <td colspan="6">
                                <div class="event-detail">
                                    <span class="detail-label">Banner: </span>
                                    @if (!noiseEvent.BannerSent)
                                    {
                                        <span>No banner sent</span>
                                    }
                                    else if (string.IsNullOrWhiteSpace(noiseEvent.Banner))
                                    {
                                        <span>Banner sent</span>
                                    }
                                    else
                                    {
                                        <code>@noiseEvent.Banner</code>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>

        <footer>
            TCPNoise Observatory &mdash; public data is intentionally sanitized.
        </footer>
    </main>
    <script>
        (() => {
            const intervalMs = @Model.RefreshIntervalMilliseconds;

            const refreshButton = document.getElementById("refresh-now");
            const autoRefresh = document.getElementById("auto-refresh");
            const status = document.getElementById("refresh-status");

            let secondsRemaining = intervalMs / 1000;
            status.textContent = `${secondsRemaining}s`;

            refreshButton.addEventListener("click", () => {
                window.location.reload();
            });

            setInterval(() => {
                if (!autoRefresh.checked) {
                    status.textContent = "paused";
                    return;
                }

                secondsRemaining--;

                if (secondsRemaining <= 0) {
                    window.location.reload();
                    return;
                }

                status.textContent = `${secondsRemaining}s`;
            }, 1000);

            autoRefresh.addEventListener("change", () => {
                secondsRemaining = intervalMs / 1000;
                status.textContent = autoRefresh.checked
                    ? `${secondsRemaining}s`
                    : "paused";
            });
        })();
    </script>
</body>
</html>
